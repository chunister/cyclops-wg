# Copie para .env e preencha. O .env NÃO vai para o repositório.

# Chave privada WireGuard gerada no painel da Surfshark (placeholder). É o
# segredo da sua conta/dispositivo: não tem "maior ou menor", só certo ou
# errado — troque só se gerar uma chave nova no painel.
WG_PRIVATE_KEY=<sua-chave-privada>

# Endereço do túnel atribuído à sua chave (aparece no .conf baixado como
# Address). Também não é um valor pra ajustar: é o que a Surfshark atribuiu
# pra essa chave específica, copie exatamente como veio no .conf.
WG_ADDRESS=10.14.0.2/16

# Servidor do gateway de teste (docker compose up, 1 gateway só): nome de um
# arquivo de servers/ sem a extensão. Trocar o valor troca o país de saída
# desse teste rápido; não afeta o controlador, que monta sua própria lista.
GATEWAY1_SERVER=alb-tirana

# Número de gateways (containers) ativos o controlador sobe.
# Maior: mais IPs de saída disponíveis ao mesmo tempo e mais tráfego
# suportado em paralelo, mas mais containers/túneis WireGuard rodando (mais
# CPU/RAM no host) e exige um catálogo em servers/ maior.
# Menor: mais leve pro host, mas menos capacidade e menos variedade de saída
# simultânea.
GATEWAY_COUNT=10

# Gateways reserva: já com o túnel aberto, substituem qualquer gateway que
# falhar. Cada rodada usa GATEWAY_COUNT + SPARE_COUNT servidores diferentes.
# Maior: promoção mais rápida se vários ativos falharem perto um do outro
# (sempre tem uma reserva pronta), mas mais containers ociosos consumindo
# recursos à toa a maior parte do tempo.
# Menor (inclusive 0): mais leve, mas se um ativo cair sem reserva saudável
# disponível, fica sem substituto até a próxima reserva ficar pronta.
SPARE_COUNT=3

# Verificação de saúde de cada gateway: intervalo entre checagens (segundos),
# quantas falhas seguidas até considerar o gateway fora do ar, e quanto
# tempo (segundos) esperar antes de reutilizar um servidor que falhou.
#
# HEALTH_INTERVAL menor: detecta queda mais rápido, mas testa com mais
# frequência (mais conexões de teste abertas e fechadas).
# HEALTH_INTERVAL maior: mais leve, mas demora mais pra perceber que um
# gateway caiu.
#
# HEALTH_FAILS menor: reage mais rápido a um problema real, mas mais sujeito
# a trocar um gateway por causa de uma falha isolada (rede instável por um
# instante, não necessariamente o servidor ruim).
# HEALTH_FAILS maior: mais tolerante a instabilidade passageira, mas demora
# mais pra agir numa queda de verdade.
#
# SERVER_COOLDOWN menor: um servidor que falhou pode ser reutilizado mais
# cedo (bom se o catálogo for pequeno), mas corre o risco de cair de novo no
# mesmo servidor problemático.
# SERVER_COOLDOWN maior: dá mais tempo pro servidor "descansar" antes de
# voltar à roleta, mas exige um catálogo maior pra não faltar opção livre.
HEALTH_INTERVAL=15
HEALTH_FAILS=3
SERVER_COOLDOWN=600

# Porta SOCKS5 de entrada do balanceador (a única porta publicada no host).
# Mudar o valor só muda qual porta você aponta o proxychains/navegador/curl;
# útil se 1080 já estiver em uso por outra coisa na sua máquina.
SOCKS_PORT=1080

# Porta do endpoint GET /status do balanceador. Mesma lógica do SOCKS_PORT:
# só muda qual porta usar, troque se 8081 já estiver ocupada.
API_PORT=8081

# Quantas conexões recentes o balanceador guarda em memória, para o painel
# "conexões recentes" do dashboard (GET /conexoes). Vale tanto rodando via
# controlador quanto via docker-compose.yml de teste.
# Maior: mais histórico pra revisar de uma vez, mais memória usada (é
# bem pouca por linha, então só pesa de verdade com valores bem altos).
# Menor: menos memória, janela mais curta de conexões visíveis.
CONN_HISTORY=20

# Gateways que o balanceador distribui, host:porta separados por vírgula.
# Só usado pelo docker-compose.yml de teste: o controlador monta essa lista
# sozinho e manda via PUT /gateways. Cada gateway usa a porta interna 1090.
GATEWAYS=gateway1:1090

# Alvo usado para testar cada gateway (um CONNECT de verdade até esse
# host:porta) e o tempo máximo (segundos) que essa conexão de teste pode
# levar antes de contar como falha. Vale tanto rodando via controlador
# quanto via docker-compose.yml.
# HEALTH_TARGET: trocar o host só muda contra o que a saúde é validada (ex:
# um serviço específico que você precisa que fique alcançável pelo túnel,
# em vez de só "a internet responde").
# DIAL_TIMEOUT menor: detecta uma conexão travada mais rápido, mas pode
# marcar como falha um gateway que só está um pouco lento, não quebrado.
# DIAL_TIMEOUT maior: mais tolerante com links lentos, mas demora mais pra
# desistir de um gateway realmente com problema.
HEALTH_TARGET=1.1.1.1:443
DIAL_TIMEOUT=10

# --- Só para o controlador (controller/), não para o docker-compose.yml de teste ---

# Pasta com os .conf de servers/ e arquivo onde o controlador guarda o
# cooldown de cada servidor entre execuções. Caminhos relativos aqui são
# ancorados na pasta do binário compilado (onde "go build -o controller ."
# deixou o executável), não no diretório de onde você chama "./controller" —
# então valem sem surpresa não importa de onde o processo for iniciado
# (shell, systemd, cron, etc). Não são valores pra "ajustar", só pra apontar
# pro lugar certo se você reorganizar as pastas do projeto.
SERVERS_DIR=../servers
STATE_FILE=./controller-state.json

# Filtro de latência do catálogo: mede o ping até o Endpoint de cada
# servidor (sem precisar montar o túnel) e guarda uma média móvel em
# LATENCY_FILE, atualizada sem parar enquanto o controlador roda. Na hora de
# escolher um servidor novo (boot, promoção de reserva, rotação completa),
# só entram no sorteio os LATENCY_TOP_SERVERS com a menor média de ping.
#
# LATENCY_TOP_SERVERS = 0 desliga o filtro inteiro: nenhum ping extra,
# sorteia em qualquer servidor do catálogo, como era antes dessa
# funcionalidade existir.
# Maior (ex: 120, de um catálogo de 145): mais diversidade geográfica de IP
# de saída, mas deixa entrar servidor mais lento na média.
# Menor (ex: 30): só os mais rápidos, latência mais baixa em geral, mas
# menos variedade de saída — e se ficar menor que GATEWAY_COUNT +
# SPARE_COUNT, o boot falha por falta de candidato suficiente (mesmo erro de
# catálogo pequeno que já existe hoje).
LATENCY_TOP_SERVERS=80

# De quantos em quantos segundos o controlador re-pinga o catálogo inteiro
# (não só os gateways em uso no momento) pra manter a média de LATENCY_FILE
# atualizada. Só tem efeito com LATENCY_TOP_SERVERS > 0.
# Menor (ex: 120 = 2min): a média reage mais rápido a uma rota que piorou ou
# melhorou, mas dispara o ping no catálogo inteiro com mais frequência
# (ainda em paralelo, mas é mais processos "ping" rodando).
# Maior (ex: 1800 = 30min): mais leve pro host, mas demora mais pra um
# servidor que piorou sair do top N, ou um que melhorou entrar.
LATENCY_CHECK_INTERVAL=600

# Onde o controlador guarda a média de ping de cada servidor entre execuções
# (mesma ideia do STATE_FILE, só que pra latência em vez de cooldown de
# servidor). Só importa com LATENCY_TOP_SERVERS > 0.
LATENCY_FILE=./latencia.json

# Onde o controlador guarda o idioma e o tema do dashboard escolhidos pelos
# atalhos (l/L, t/T), pra abrir no mesmo estado da próxima vez em vez de
# sempre voltar pro DASH_LANG/tema padrão daqui do .env. "" desliga: cada
# execução parte sempre do valor fixo abaixo. Importante: depois da primeira
# troca pelo teclado, o valor salvo aqui passa a valer mais que DASH_LANG, até
# você trocar nos atalhos de novo ou apagar o arquivo.
PREFS_FILE=./dashboard-prefs.json

# Rede Docker e imagens que o controlador cria e usa. Nomes/tags, não
# valores pra ajustar — troque só se já tiver algo com esse nome no seu
# Docker e quiser evitar conflito.
DOCKER_NETWORK=cyclops-net
GATEWAY_IMAGE=cyclops-gateway:dev
BALANCER_IMAGE=cyclops-balancer:dev

# Onde o controlador encontra o balanceador para atualizar a lista de
# ativos. Só muda se você rodar o balanceador num host/porta diferente do
# padrão (ex: atrás de outro proxy reverso).
BALANCER_API_ADDR=http://127.0.0.1:8081

# Porta do GET /status do próprio controlador. Mesma lógica do SOCKS_PORT:
# só muda qual porta usar.
CONTROLLER_PORT=9090

# Dashboard no terminal, ao vivo, no lugar do log cru.
# 1: tela interativa (precisa de terminal de verdade na frente).
# 0: log cru no stderr, sem interface — use rodando sem terminal interativo
# (nohup, systemd) e acompanhe por GET /status em vez da tela.
DASHBOARD=1

# Rotação completa: a cada N segundos, troca o servidor de TODOS os gateways
# de uma vez (não só dos que falharam), pra variar os IPs de saída mesmo sem
# queda. Também pode ser disparada na hora apertando "r" no dashboard.
# 0 desliga a rotação automática (só dispara manual, via "r").
# Menor: os IPs de saída mudam com mais frequência, mas cada rotação briga
# por servidor novo pra todo mundo de uma vez (exige catálogo com bastante
# folga além de GATEWAY_COUNT + SPARE_COUNT) e causa uma interrupção breve
# em cada gateway durante a troca.
# Maior: menos interrupções, mas os IPs de saída ficam fixos por mais tempo.
FULL_ROTATE_INTERVAL=0

# Idioma do dashboard e das mensagens de log do controlador: en, pt-br ou
# es. Também pode ser trocado na hora apertando "l" no dashboard. É escolha,
# não tem "maior ou menor".
DASH_LANG=en

# Além da tela, grava o mesmo log também neste arquivo (modo acréscimo), pra
# dar pra revisar depois mesmo se o painel de eventos ou o terminal ficarem
# difíceis de ler (ex: durante um teste de carga). "" desliga.
LOG_FILE=./controller.log
