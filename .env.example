# Copie para .env e preencha. O .env NÃO vai para o repositório.

# Chave privada WireGuard gerada no painel da Surfshark (placeholder)
WG_PRIVATE_KEY=<sua-chave-privada>

# Endereço do túnel atribuído à sua chave (aparece no .conf baixado como Address)
WG_ADDRESS=10.14.0.2/16

# Servidor do gateway de teste: nome de um arquivo de servers/ sem a extensão
GATEWAY1_SERVER=alb-tirana

# Número de gateways (containers) de saída
GATEWAY_COUNT=10

# Gateways reserva: já com o túnel aberto, substituem qualquer gateway que falhar.
# Cada rodada usa GATEWAY_COUNT + SPARE_COUNT servidores diferentes.
SPARE_COUNT=3

# Verificação de saúde: intervalo em segundos, falhas seguidas até desativar
# um gateway e tempo de espera (segundos) antes de reutilizar um servidor que falhou
HEALTH_INTERVAL=15
HEALTH_FAILS=3
SERVER_COOLDOWN=600

# Porta SOCKS5 de entrada do balanceador (a única porta publicada no host)
SOCKS_PORT=1080

# Porta do endpoint GET /status do balanceador
API_PORT=8081

# Quantas conexões recentes o balanceador guarda em memória, para o painel
# "conexões recentes" do dashboard (GET /conexoes)
CONN_HISTORY=20

# Gateways que o balanceador distribui, host:porta separados por vírgula.
# No docker-compose.yml de teste, cada gateway usa a porta interna 1090.
GATEWAYS=gateway1:1090

# Alvo usado para testar cada gateway e o tempo máximo de uma conexão de teste
HEALTH_TARGET=1.1.1.1:443
DIAL_TIMEOUT=10

# --- Só para o controlador (controller/), não para o docker-compose.yml de teste ---

# Pasta com os .conf de servers/ e arquivo onde o controlador guarda o
# cooldown de cada servidor entre execuções
SERVERS_DIR=./servers
STATE_FILE=./controller-state.json

# Rede Docker e imagens que o controlador cria e usa
DOCKER_NETWORK=cyclops-net
GATEWAY_IMAGE=cyclops-gateway:dev
BALANCER_IMAGE=cyclops-balancer:dev

# Onde o controlador encontra o balanceador para atualizar a lista de ativos
BALANCER_API_ADDR=http://127.0.0.1:8081

# Porta do GET /status do próprio controlador
CONTROLLER_PORT=9090

# Dashboard no terminal, ao vivo, no lugar do log cru. Desligue com 0 se for
# rodar sem terminal interativo (ex: nohup, systemd).
DASHBOARD=1

# Rotação completa: a cada N segundos, troca o servidor de TODOS os gateways
# de uma vez (não só dos que falharam), pra variar os IPs de saída mesmo sem
# queda. 0 desliga. Também pode ser disparada na hora apertando "r" no
# dashboard. Exige catálogo de servers/ com bastante folga além de
# GATEWAY_COUNT + SPARE_COUNT, já que todos competem por servidor novo ao
# mesmo tempo.
FULL_ROTATE_INTERVAL=0
