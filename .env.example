# Copie para .env e preencha. O .env NÃO vai para o repositório.

# Chave privada WireGuard gerada no painel da Surfshark (placeholder)
WG_PRIVATE_KEY=<sua-chave-privada>

# Endereço do túnel atribuído à sua chave (aparece no .conf baixado como Address)
WG_ADDRESS=10.14.0.2/16

# Servidor do gateway de teste: nome de um arquivo de servers/ sem a extensão
GATEWAY1_SERVER=alb-tirana

# Número de gateways (containers) de saída
GATEWAY_COUNT=10

# Gateways reserva: já com o túnel aberto, substituem qualquer gateway que falhar.
# Cada rodada usa GATEWAY_COUNT + SPARE_COUNT servidores diferentes.
SPARE_COUNT=3

# Verificação de saúde: intervalo em segundos, falhas seguidas até desativar
# um gateway e tempo de espera (segundos) antes de reutilizar um servidor que falhou
HEALTH_INTERVAL=15
HEALTH_FAILS=3
SERVER_COOLDOWN=600

# Porta SOCKS5 de entrada do balanceador (a única porta publicada no host)
SOCKS_PORT=1080

# Porta do endpoint GET /status do balanceador
API_PORT=8081

# Gateways que o balanceador distribui, host:porta separados por vírgula.
# No docker-compose.yml de teste, cada gateway usa a porta interna 1090.
GATEWAYS=gateway1:1090

# Alvo usado para testar cada gateway e o tempo máximo de uma conexão de teste
HEALTH_TARGET=1.1.1.1:443
DIAL_TIMEOUT=10

# Política de rotação: time | requests | manual
ROTATION_MODE=time
ROTATION_INTERVAL=300

# Servidores WireGuard permitidos (separados por vírgula), ex.: us-nyc,de-fra,nl-ams
SERVERS=
