# Segredos locais: nunca versionar
.env
*.env.local

# Configurações WireGuard geradas (contêm chave privada)
wireguard/*.conf
*.conf.local

# Build e artefatos
bin/
dist/
*.exe

# Editores e SO
.DS_Store
.idea/
.vscode/

# Configs WireGuard completas (contêm PrivateKey ao colar a chave)
raw/

# Controlador: binário compilado, o estado de cooldown dos servidores, a
# média de latência do catálogo, as preferências do dashboard (idioma/tema)
# e o log
controller/controller
controller/controller-state.json
controller/latencia.json
controller/dashboard-prefs.json
controller/controller.log
